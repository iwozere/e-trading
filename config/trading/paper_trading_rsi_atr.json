{
  "bot_id": "paper_trading_rsi_atr",
  "symbol": "LTCUSDT",
  "description": "Paper trading bot with RSIOrBBEntryMixin + ATRExitMixin strategy",
  "environment": "development",
  "version": "1.0.0",
  "broker": {
    "type": "binance",
    "trading_mode": "paper",
    "cash": 10000.0,
    "initial_balance": 10000.0,
    "commission": 0.001
  },
  "trading": {
    "symbol": "LTCUSDT",
    "position_size": 0.1,
    "max_positions": 3,
    "max_drawdown_pct": 20.0,
    "max_exposure": 1.0
  },
  "data": {
    "data_source": "binance",
    "symbol": "LTCUSDT",
    "interval": "4h",
    "lookback_bars": 1000,
    "retry_interval": 60
  },
  "strategy": {
    "type": "CustomStrategy",
    "parameters": {
      "position_size": 0.1,
      "entry_logic": {
        "name": "RSIOrBBEntryMixin",
        "params": {
          "e_rsi_period": 20,
          "e_rsi_oversold": 25,
          "e_bb_period": 16,
          "e_bb_dev": 2.08,
          "e_rsi_cross": false,
          "e_bb_reentry": false,
          "e_cooldown_bars": 4,
          "e_use_bb_touch": true
        }
      },
      "exit_logic": {
        "name": "ATRExitMixin",
        "params": {
          "x_atr_period": 14,
          "x_sl_multiplier": 2.0
        }
      },
      "use_talib": true
    }
  },
  "risk_management": {
    "stop_loss_pct": 5.0,
    "take_profit_pct": 10.0,
    "max_daily_trades": 10,
    "max_daily_loss": 100.0
  },
  "logging": {
    "level": "INFO",
    "save_trades": true,
    "save_equity_curve": true,
    "log_file": "logs/paper_trading_rsi_atr.log"
  },
  "notifications": {
    "telegram_enabled": false,
    "email_enabled": false,
    "error_notifications": true
  },
  "trading_settings": {
    "enable_database_logging": true,
    "bot_type": "paper",
    "description": "Paper trading with RSI/BB entry and ATR exit strategy"
  }
}
