{
  "bot_id": "env_bot_production",
  "symbol": "BTCUSDT",
  "description": "Environment-specific bot for production",
  "environment": "production",
  "version": "1.0.0",
  "broker": {
    "type": "binance",
    "trading_mode": "paper",
    "cash": 50000.0,
    "initial_balance": 50000.0,
    "commission": 0.001
  },
  "trading": {
    "symbol": "BTCUSDT",
    "position_size": 0.1,
    "max_positions": 3,
    "max_drawdown_pct": 20.0,
    "max_exposure": 1.0
  },
  "data": {
    "data_source": "binance",
    "symbol": "BTCUSDT",
    "interval": "1h",
    "lookback_bars": 1000,
    "retry_interval": 60
  },
  "strategy": {
    "type": "CustomStrategy",
    "parameters": {
      "position_size": 0.1
    }
  },
  "risk_management": {
    "stop_loss_pct": 3.0,
    "take_profit_pct": 10.0,
    "max_daily_trades": 10,
    "max_daily_loss": 50.0
  },
  "logging": {
    "level": "WARNING",
    "save_trades": true,
    "save_equity_curve": true,
    "log_file": null
  },
  "notifications": {
    "telegram_enabled": true,
    "email_enabled": true,
    "error_notifications": true
  }
}
