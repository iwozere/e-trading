{
  "bot_id": "sample_bot_001",
  "symbol": "BTCUSDT",
  "description": "Sample trading bot configuration in new simplified format",
  "environment": "development",
  "version": "1.0.0",
  "broker": {
    "type": "binance",
    "trading_mode": "paper",
    "cash": 10000.0,
    "initial_balance": 10000.0,
    "commission": 0.001
  },
  "trading": {
    "symbol": "BTCUSDT",
    "position_size": 0.1,
    "max_positions": 5,
    "max_drawdown_pct": 20.0,
    "max_exposure": 1.0
  },
  "data": {
    "data_source": "binance",
    "symbol": "BTCUSDT",
    "interval": "1h",
    "lookback_bars": 1000,
    "retry_interval": 60
  },
  "strategy": {
    "type": "CustomStrategy",
    "parameters": {
      "position_size": 0.1,
      "legacy_strategy_params": {
        "entry": {
          "rsi_period": 14,
          "rsi_oversold": 30,
          "bb_period": 20,
          "bb_dev": 2.0
        },
        "exit": {
          "rsi_period": 14,
          "rsi_overbought": 70
        },
        "use_talib": false
      }
    }
  },
  "risk_management": {
    "stop_loss_pct": 5.0,
    "take_profit_pct": 10.0,
    "max_daily_trades": 10,
    "max_daily_loss": 50.0
  },
  "logging": {
    "level": "INFO",
    "save_trades": true,
    "save_equity_curve": true,
    "log_file": "logs/simulation/sample_bot_001.log"
  },
  "notifications": {
    "telegram_enabled": false,
    "email_enabled": false,
    "error_notifications": true
  }
}
