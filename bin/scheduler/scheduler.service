[Unit]
Description=E-Trading Scheduler Service
Documentation=https://github.com/iwozere/e-trading
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
# IMPORTANT: Update User, Group, and WorkingDirectory for your installation
User=alkotrader
Group=alkotrader
WorkingDirectory=/opt/apps/e-trading
ExecStart=/opt/apps/e-trading/.venv/bin/python -m src.scheduler.main
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=e-trading-scheduler

# Environment variables
# IMPORTANT: Update these for your environment
EnvironmentFile=/opt/apps/e-trading/config/donotshare/.env
Environment="PYTHONPATH=/opt/apps/e-trading"
Environment="PYTHONUNBUFFERED=1"
Environment="TRADING_ENV=production"
Environment="LOG_LEVEL=INFO"
Environment="SCHEDULER_MAX_WORKERS=10"
Environment="DATA_CACHE_ENABLED=true"
# This venv runs Python 3.14 (newer than the project's tested 3.13 baseline).
# numba's on-disk JIT cache locator is broken under 3.14 for pandas_ta_classic's
# @njit(cache=True) functions ("no locator available for file"), crashing at
# import time (AlertEvaluator -> IndicatorService -> PandasTaAdapter). Disabling
# JIT caching sidesteps it -- indicators run as plain Python instead of compiled,
# slower but correct. Remove once the venv is rebuilt against Python 3.13 to
# match the rest of the project.
Environment="NUMBA_DISABLE_JIT=1"

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/apps/e-trading/logs
ReadWritePaths=/opt/apps/e-trading/data
ReadWritePaths=/share/data-cache
ReadWritePaths=/opt/apps/e-trading/results

# Resource limits
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target