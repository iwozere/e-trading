# Real IBKR brokerage exports (holdings + cost basis) — downloaded daily by
# src/portfolio/pnl_alert/flex_downloader.py into data/portfolio/pnl_alert/,
# already covered by the blanket data/ ignore below. Never commit these.
# Also ignore the pre-migration location in case stale exports are still there.
src/portfolio/pnl_alert/config/Open_Positions.xml
src/portfolio/pnl_alert/config/Open_Positions-*.xml

# Testing
.coverage
htmlcov/
.pytest_cache/ 

*.db
db/
data/
test_cache/
!config/data/
!src/data/
!src/data/db/
# Source packages that happen to be named "data/" — these are code, not data,
# and must be tracked (otherwise CI checks out a tree missing these modules).
!src/vectorbt/data/
!src/ml/pipeline/p04_short_squeeze/data/
!src/ml/pipeline/p21_momentum/data/
results/
# Same story for a source package literally named "results/" (holds run_io.py,
# not run output) — see the "data/" note above; p21_momentum's *output* directory
# is results/p21_momentum/ at the project root, which the bare results/ rule above
# still (correctly) ignores.
!src/ml/pipeline/p21_momentum/results/
temp/

